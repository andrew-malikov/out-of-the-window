        "meta.block",
        "meta.tag.attributes",
        "entity.name.constant",
        "meta.object.member",
        "meta.embedded.expression"
      ],
      "settings": {
        "foreground": "#2C3135"
      }
    },
    {
      "scope": [
        "entity.name.tag",
